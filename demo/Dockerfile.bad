# INSECURE on purpose: review it with the tool, then compare with Dockerfile.good
FROM python:latest
MAINTAINER demo@example.com
ENV SECRET_KEY=my-super-secret-key-123
WORKDIR app
ADD . .
RUN apt-get update
RUN apt-get install -y curl
RUN pip install -r requirements.txt
RUN chmod -R 777 /app
EXPOSE 22 5000
CMD python app.py
